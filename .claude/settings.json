{
  "outputStyle": "default",
  "permissions": {
    "ask": [
      "Bash(git push*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(fly *)",
      "Bash(flyctl *)",
      "Bash(docker *)"
    ]
  },
  "sandbox": {
    "filesystem": {
      "allowRead": [
        ".env.example"
      ],
      "allowWrite": [
        "/Users/michellerojas/rust-nyc-pop-quiz/.lattice"
      ]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/install-flyctl.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/install-just.sh"
          }
        ]
      }
    ]
  }
}
