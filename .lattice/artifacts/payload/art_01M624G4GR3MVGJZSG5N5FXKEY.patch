+++ b/room/src/answers/catalog.rs
@@ -0,0 +1,83 @@
+//! Private bank access for the organizer picker. Only id/topic leave this module;
+//! arranging a record hands back a sealed Scheduled, never an answer or JSON.
+use super::{load_record, LoadError, Record, Scheduled};
+use crate::club::ClubSlug;
+use crate::slot::MeetupDate;
+use serde::Serialize;
+
+include!(concat!(env!("OUT_DIR"), "/bank.rs"));
+
+pub struct Catalog {
+    records: Vec<String>,
+}
+
+#[derive(Serialize)]
+pub struct Choice {
+    pub id: String,
+    pub topic: String,
+}
+
+impl Default for Catalog {
+    fn default() -> Self {
+        Self::from_records(RECORDS.iter().map(|s| s.to_string()).collect())
+    }
+}
+
+impl Catalog {
+    /// Also supports a private bank supplied by a test, without adding a route
+    /// that can upload or approve arbitrary records through an organizer login.
+    pub fn from_records(records: Vec<String>) -> Self { Self { records } }
+
+    pub fn choices(&self, club: &ClubSlug) -> Vec<Choice> {
+        self.records.iter().filter_map(|json| {
+            let record = Record::from_json(json).ok()?;
+            if !eligible(&record, club) { return None; }
+            let choice = Choice { id: record.id.clone(), topic: record.topic.clone() };
+            load_record(record).ok()?;
+            Some(choice)
+        }).collect()
+    }
+
+    pub fn prepare(&self, id: &str, day: &str, club: &ClubSlug) -> Result<Scheduled, LoadError> {
+        let day = MeetupDate::parse(day).ok_or_else(|| LoadError("Choose a valid meetup date.".into()))?;
+        for json in &self.records {
+            let Ok(mut record) = Record::from_json(json) else { continue; };
+            if record.id != id || !eligible(&record, club) { continue; }
+            // Validate before indexing: a malformed bank entry must not panic.
+            super::load(json).map_err(|_| unavailable())?;
+            let correct = record.correct_index().map_err(|_| unavailable())?.ok_or_else(unavailable)?;
+            let answer = record.options.remove(correct);
+            let mut random = crate::slot::shuffle_stream(day.as_str(), id);
+            for i in (1..record.options.len()).rev() {
+                record.options.swap(i, random.next(i + 1));
+            }
+            record.options.insert(crate::slot::slot_for_day(&day), answer);
+            return load_record(record).map_err(|_| unavailable());
+        }
+        Err(unavailable())
+    }
+}
+
+fn unavailable() -> LoadError {
+    LoadError("That question is not ready for this club. Choose an approved, unused question.".into())
+}
+
+fn eligible(record: &Record, club: &ClubSlug) -> bool {
+    let Some(review) = &record.review else { return false; };
+    if !matches!(review.get("status").and_then(|v| v.as_str()), Some("accepted" | "edited")) {
+        return false;
+    }
+    if ["affirmed_by", "affirmed_at"].iter().any(|key| {
+        !review.get(key).and_then(|v| v.as_str()).is_some_and(|s| !s.trim().is_empty())
+    }) { return false; }
+    let unused = |entry: &serde_json::Value| {
+        entry.is_object() && entry.get("club").map_or(Some("nyc"), |v| v.as_str())
+            .is_some_and(|used_club| used_club != club.as_str())
+    };
+    match &record.used {
+        None | Some(serde_json::Value::Null) => true,
+        Some(serde_json::Value::Array(entries)) => entries.iter().all(unused),
+        Some(entry) if entry.is_object() => unused(entry),
+        _ => false,
+    }
+}
