+async fn organizer_questions(State(state): State<Arc<AppState>>, headers: HeaderMap,
+    Query(query): Query<std::collections::HashMap<String, String>>) -> Response {
+    let club = match club_of(query.get("club").map(String::as_str)) {
+        Ok(club) => club, Err(e) => return failure(e),
+    };
+    match state.organizer_questions(bearer(&headers), &club).await {
+        Ok(questions) => Json(serde_json::json!({"questions": questions})).into_response(),
+        Err(e) => failure(e),
+    }
+}
+
+async fn schedule_question(State(state): State<Arc<AppState>>, headers: HeaderMap,
+    Json(body): Json<ScheduleBody>) -> Response {
+    let club = match club_of(body.club.as_deref()) {
+        Ok(club) => club, Err(e) => return failure(e),
+    };
+    match state.schedule_from_bank(bearer(&headers), &club, &body.question_id, &body.date).await {
+        Ok(scheduled) => {
+            let (status, label) = match scheduled {
+                crate::rooms::Scheduling::New => (StatusCode::CREATED, "new"),
+                crate::rooms::Scheduling::Replaced => (StatusCode::OK, "replaced"),
+            };
+            (status, Json(serde_json::json!({"id": body.question_id, "date": body.date, "scheduled": label}))).into_response()
+        }
+        Err(e) => failure(e),
+    }
+}
