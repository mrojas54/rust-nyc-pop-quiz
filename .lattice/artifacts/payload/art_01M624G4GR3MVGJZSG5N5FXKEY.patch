--- /dev/null
+++ b/room/src/slot.rs
@@ -0,0 +1,45 @@
+//! Twin of pipeline/popquiz/slot.py: the answer position depends on the date
+//! alone. No bank, club, history, previous letter, balancing, or quota input.
+use blake2::{Blake2bVar, digest::{Update, VariableOutput}};
+
+pub struct MeetupDate(String);
+impl MeetupDate {
+    pub fn parse(raw: &str) -> Option<Self> {
+        let bytes = raw.as_bytes();
+        if bytes.len() != 10 || bytes[4] != b'-' || bytes[7] != b'-'
+            || bytes.iter().enumerate().any(|(i, b)| i != 4 && i != 7 && !b.is_ascii_digit()) {
+            return None;
+        }
+        let year: u32 = raw[..4].parse().ok()?;
+        let month: usize = raw[5..7].parse().ok()?;
+        let day: u32 = raw[8..].parse().ok()?;
+        let leap = year % 4 == 0 && (year % 100 != 0 || year % 400 == 0);
+        let days = [0, 31, if leap {29} else {28}, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
+        if year == 0 || month == 0 || month > 12 || day == 0 || day > days[month] { return None; }
+        Some(Self(raw.into()))
+    }
+    pub fn as_str(&self) -> &str { &self.0 }
+}
+
+pub(crate) struct Stream(u64);
+impl Stream {
+    fn new(seed: &str) -> Self {
+        let mut hash = Blake2bVar::new(8).expect("eight-byte BLAKE2b");
+        hash.update(seed.as_bytes());
+        let mut bytes = [0; 8];
+        hash.finalize_variable(&mut bytes).expect("eight-byte output");
+        Self(u64::from_be_bytes(bytes))
+    }
+    pub(crate) fn next(&mut self, bound: usize) -> usize {
+        self.0 = self.0.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
+        ((self.0 >> 33) % bound as u64) as usize
+    }
+}
+
+pub fn slot_for_day(day: &MeetupDate) -> usize {
+    Stream::new(&format!("meetup-slot|{}", day.as_str())).next(5)
+}
+
+pub(crate) fn shuffle_stream(day: &str, id: &str) -> Stream {
+    Stream::new(&format!("distractors|{day}|{id}"))
+}
