diff --git a/web/test/host-scheduling.test.js b/web/test/host-scheduling.test.js
new file mode 100644
index 0000000..ee2d0dc
--- /dev/null
+++ b/web/test/host-scheduling.test.js
@@ -0,0 +1,119 @@
+// Drive the real host controller against deterministic HTTP replies.
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const vm = require('node:vm');
+const { load } = require('./_load.js');
+const D = require('./a11y/dom.js');
+const settle = () => new Promise(resolve => setImmediate(resolve));
+const response = (status, body) => ({ok: status >= 200 && status < 300, status,
+  json: async () => body, text: async () => JSON.stringify(body)});
+
+function rig(reply, search = '?club=nyc') {
+  const { PQ, sandbox } = load('all', { timers: false });
+  vm.runInContext(fs.readFileSync(path.join(__dirname, '../host/host.js'), 'utf8'), sandbox);
+  const doc = D.page('', [{tag:'body',attrs:{}},{tag:'main',attrs:{id:'host',class:'host-phone'}}]);
+  const el = doc.root, handlers = {}, calls = [], navigations = [], timers = [];
+  el.addEventListener = (event, handler) => { handlers[event] = handler; };
+  const win = {document:doc, AbortController,
+    location:{pathname:'/host',search,hash:'#organizer-test',replace:url=>navigations.push(url)},
+    history:{replaceState(){}},sessionStorage:{setItem(){}},
+    setTimeout:fn=>{timers.push(fn); return timers.length;},clearTimeout(){},
+    fetch:(url, init)=>{calls.push({url,init}); return reply(url, init);}};
+  PQ.host.boot(win);
+  function submit(valid = true) {
+    const form = el.querySelector('[data-schedule-form]');
+    assert.ok(form, 'form is present');
+    form.matches = selector => selector === '[data-schedule-form]';
+    form.reportValidity = () => valid;
+    const question = el.querySelector('#schedule-question'), date = el.querySelector('#schedule-date');
+    question.value = 'q3'; date.value = '2026-10-21';
+    handlers.submit({target:form,preventDefault(){}});
+  }
+  function click(selector) { const target = el.querySelector(selector); assert.ok(target, selector); handlers.click({target}); }
+  return {PQ,win,doc,el,calls,navigations,timers,submit,click};
+}
+const catalog = () => Promise.resolve(response(200,{questions:[{id:'q3',topic:'Collections'}]}));
+
+test('pick, schedule, confirm, and create use the same question and club', async () => {
+  const r = rig((url) => {
+    if (url.startsWith('/organizer/questions')) return catalog();
+    if (url === '/organizer/schedule') return Promise.resolve(response(201,{id:'q3',date:'2026-10-21',scheduled:'new'}));
+    return Promise.resolve(response(201,{host_resume_url:'/host/test-room#host-test'}));
+  }, '?club=la');
+  await settle();
+  assert.ok(!r.el.querySelector('[data-primary]'));
+  r.submit(false); assert.equal(r.calls.length,1, 'invalid form cannot schedule');
+  r.el.querySelector('[data-schedule]').focus();
+  r.submit(); await settle();
+  assert.match(r.el.textContent,/q3 is scheduled for 2026-10-21/);
+  assert.equal(r.doc.activeElement.getAttribute('data-primary'),'create');
+  assert.deepEqual(JSON.parse(r.calls[1].init.body),{question_id:'q3',club:'la',date:'2026-10-21'});
+  assert.equal(r.calls[1].init.headers.Authorization,'Bearer organizer-test');
+  assert.ok(!r.el.innerHTML.includes('organizer-test'));
+  r.click('[data-primary]'); await settle();
+  assert.deepEqual(JSON.parse(r.calls[2].init.body),{question_id:'q3',club:'la'});
+  assert.deepEqual(r.navigations,['/host/test-room#host-test']);
+});
+
+test('double submit is suppressed and changing the date requires scheduling again', async () => {
+  let finish;
+  const r = rig(url => url.startsWith('/organizer/questions') ? catalog() : new Promise(resolve=>{finish=resolve;}));
+  await settle(); r.submit(); r.submit();
+  assert.equal(r.calls.length,2);
+  assert.ok(r.el.querySelector('[data-schedule]').disabled);
+  finish(response(200,{id:'q3',date:'2026-10-21',scheduled:'replaced'})); await settle();
+  r.click('[data-edit-schedule]');
+  assert.ok(!r.el.querySelector('[data-primary]'));
+  assert.equal(r.el.querySelector('#schedule-date').getAttribute('value'),'2026-10-21');
+});
+
+test('refusal retains the selection and date, with no create action', async () => {
+  const r = rig(url=>url.startsWith('/organizer/questions') ? catalog() : Promise.resolve(response(409,{reason:'Already in a room.'})));
+  await settle(); r.submit(); await settle();
+  assert.match(r.el.textContent,/Already in a room/);
+  assert.equal(r.el.querySelector('#schedule-date').getAttribute('value'),'2026-10-21');
+  assert.ok(!r.el.querySelector('[data-primary]'));
+});
+
+test('expired scheduling authorization returns to Discord sign-in', async () => {
+  const r = rig(url=>url.startsWith('/organizer/questions') ? catalog() : Promise.resolve(response(401,null)));
+  await settle(); r.submit(); await settle();
+  assert.ok(r.el.querySelector('[data-sign-in]'));
+  assert.ok(!r.el.querySelector('[data-primary]'));
+});
+
+test('lost scheduling response unlocks retry without claiming success', async () => {
+  const r = rig(url=>url.startsWith('/organizer/questions') ? catalog() : Promise.reject(new Error('offline')));
+  await settle(); r.submit(); await settle();
+  assert.match(r.el.textContent,/Could not confirm scheduling/);
+  assert.ok(!r.el.querySelector('[data-schedule]').disabled);
+  assert.ok(!r.el.querySelector('[data-primary]'));
+});
+
+test('a missing server schedule returns to the form after creation refusal', async () => {
+  const r = rig(url=>url.startsWith('/organizer/questions') ? catalog() : Promise.resolve(url === '/organizer/schedule'
+    ? response(201,{id:'q3',date:'2026-10-21',scheduled:'new'})
+    : response(409,{reason:'No question is scheduled with that id.'})));
+  await settle(); r.submit(); await settle(); r.click('[data-primary]'); await settle();
+  assert.match(r.el.textContent,/No question is scheduled/);
+  assert.ok(r.el.querySelector('[data-schedule]'));
+  assert.equal(r.el.querySelector('#schedule-date').getAttribute('value'),'2026-10-21');
+});
+
+test('empty catalog and failed catalog both provide a working reload', async () => {
+  let count=0;
+  const r = rig(()=>++count === 1 ? Promise.reject(new Error('offline')) : Promise.resolve(response(200,{questions:[]})));
+  await settle(); assert.match(r.el.textContent,/Could not load questions/);
+  r.click('[data-reload-questions]'); await settle();
+  assert.match(r.el.textContent,/No approved, unused questions/);
+  assert.ok(!r.el.querySelector('[data-primary]'));
+});
+
+test('catalog strings and errors are escaped', async () => {
+  const r = rig(()=>Promise.resolve(response(200,{questions:[{id:'<id>',topic:'<script>secret</script>'}]})));
+  await settle();
+  assert.ok(!r.el.innerHTML.includes('<script>'));
+  assert.match(r.el.innerHTML,/&lt;script&gt;/);
+});
