@@ -0,0 +1,19 @@
+"""Shared ordering vectors keep browser scheduling and the CLI in agreement."""
+import json
+from datetime import date
+from pathlib import Path
+
+from popquiz.bank import load_question
+from popquiz.schedule import arrange
+from popquiz.slot import slot_for_day
+
+
+def test_browser_scheduling_vectors_match_pipeline() -> None:
+    repo = Path(__file__).resolve().parents[2]
+    question = load_question(repo / "bank", "q3")
+    cases = json.loads((repo / "bank/fixtures/scheduling-order.json").read_text())
+    assert len(cases) == 731
+    for raw_date, slot, order in cases:
+        day = date.fromisoformat(raw_date)
+        assert slot_for_day(day) == slot
+        assert [question.options.index(o) for o in arrange(question, day).options] == order
