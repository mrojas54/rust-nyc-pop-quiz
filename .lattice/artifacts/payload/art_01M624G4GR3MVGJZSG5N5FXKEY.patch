@@ -0,0 +1,16 @@
+// Embed the private bank in the server binary, never in a browser asset.
+use std::{env, fs, path::PathBuf};
+
+fn main() {
+    let bank = PathBuf::from(env::var_os("CARGO_MANIFEST_DIR").unwrap()).join("../bank/questions");
+    println!("cargo:rerun-if-changed={}", bank.display());
+    let mut paths: Vec<_> = fs::read_dir(bank).expect("private question bank")
+        .map(|e| e.unwrap().path()).filter(|p| p.extension().is_some_and(|e| e == "json")).collect();
+    paths.sort();
+    let mut code = String::from("const RECORDS: &[&str] = &[\n");
+    for path in paths {
+        code.push_str(&format!("{:?},\n", fs::read_to_string(path).expect("bank record")));
+    }
+    code.push_str("];\n");
+    fs::write(PathBuf::from(env::var_os("OUT_DIR").unwrap()).join("bank.rs"), code).unwrap();
+}
