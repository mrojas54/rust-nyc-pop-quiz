+//! Browser scheduling uses organizer auth, never the pipeline admin secret.
+mod common;
+use std::sync::Arc;
+use axum::http::{Method, StatusCode};
+use common::*;
+use room::rooms::{AppState, Urls};
+use serde_json::json;
+
+fn app() -> axum::Router {
+    room::router_with(Arc::new(AppState::new(Arc::new(TestAuth), vec![], Urls::default())))
+}
+
+#[tokio::test]
+async fn catalog_and_schedule_require_the_clubs_organizer_role() {
+    let app = app();
+    for token in [None, Some("unknown")] {
+        assert_eq!(http(&app, Method::GET, "/organizer/questions?club=nyc", token, None).await.0, StatusCode::UNAUTHORIZED);
+        assert_eq!(http(&app, Method::POST, "/organizer/schedule", token,
+            Some(json!({"question_id":"q3", "date":"2026-10-21", "club":"nyc"}))).await.0, StatusCode::UNAUTHORIZED);
+    }
+    assert_eq!(http(&app, Method::GET, "/organizer/questions?club=la", Some(NYC_ONLY), None).await.0, StatusCode::FORBIDDEN);
+    assert_eq!(http(&app, Method::POST, "/organizer/schedule", Some(NYC_ONLY),
+        Some(json!({"question_id":"q3", "date":"2026-10-21", "club":"la"}))).await.0, StatusCode::FORBIDDEN);
+}
+
+#[tokio::test]
+async fn organizer_can_pick_schedule_and_create_without_an_admin_token() {
+    let app = app();
+    let (status, catalog) = http(&app, Method::GET, "/organizer/questions", Some(ORGANIZER), None).await;
+    assert_eq!(status, StatusCode::OK, "{catalog}");
+    let q = catalog["questions"].as_array().unwrap().iter().find(|q| q["id"] == "q3").expect("approved q3");
+    assert_eq!(q.as_object().unwrap().keys().map(String::as_str).collect::<Vec<_>>(), ["id", "topic"]);
+    let (status, scheduled) = http(&app, Method::POST, "/organizer/schedule", Some(ORGANIZER),
+        Some(json!({"question_id":"q3", "date":"2026-10-21"}))).await;
+    assert_eq!(status, StatusCode::CREATED, "{scheduled}");
+    assert_eq!(scheduled, json!({"id":"q3", "date":"2026-10-21", "scheduled":"new"}));
+    let hosted = host_room(&app).await;
+    let (_, host) = http(&app, Method::GET, &format!("/rooms/{}/host", hosted.id), Some(&hosted.host), None).await;
+    assert!(host.get("correct").is_none());
+    // A second schedule must not replace a question held by a room.
+    assert_eq!(http(&app, Method::POST, "/organizer/schedule", Some(ORGANIZER),
+        Some(json!({"question_id":"q3", "date":"2026-10-22"}))).await.0, StatusCode::CONFLICT);
+}
+
+#[tokio::test]
+async fn invalid_dates_and_unapproved_questions_never_become_rooms() {
+    let app = app();
+    for date in ["2026-02-29", "2026-13-01", "2026-1-01", "0000-01-01", "2026-10-21T00:00:00"] {
+        let (status, _) = http(&app, Method::POST, "/organizer/schedule", Some(ORGANIZER),
+            Some(json!({"question_id":"q3", "date":date}))).await;
+        assert_eq!(status, StatusCode::CONFLICT, "{date}");
+    }
+    for id in ["unknown", "q4", "../q3"] {
+        assert_eq!(http(&app, Method::POST, "/organizer/schedule", Some(ORGANIZER),
+            Some(json!({"question_id":id, "date":"2026-10-21"}))).await.0, StatusCode::CONFLICT);
+    }
+    assert_eq!(http(&app, Method::POST, "/rooms", Some(ORGANIZER),
+        Some(json!({"question_id":"q3"}))).await.0, StatusCode::CONFLICT);
+}
+
+fn with_records(records: Vec<serde_json::Value>) -> axum::Router {
+    room::router_with(Arc::new(AppState::new(Arc::new(TestAuth), vec![], Urls::default())
+        .with_catalog(room::answers::catalog::Catalog::from_records(records.iter().map(ToString::to_string).collect()))))
+}
+
+#[tokio::test]
+async fn catalog_canary_never_leaves_the_sealed_module() {
+    use axum::{body::Body, http::Request};
+    use tower::ServiceExt;
+    let app = with_records(vec![planted()]);
+    let (status, list) = http(&app, Method::GET, "/organizer/questions", Some(ORGANIZER), None).await;
+    assert_eq!(status, StatusCode::OK);
+    assert_eq!(list, json!({"questions":[{"id":"planted", "topic":q3_json()["topic"]}]}));
+    for (day, expected) in [("2026-10-21", StatusCode::CREATED), ("invalid", StatusCode::CONFLICT)] {
+        let (status, body) = http(&app, Method::POST, "/organizer/schedule", Some(ORGANIZER),
+            Some(json!({"question_id":"planted", "date":day}))).await;
+        assert_eq!(status, expected);
+        assert!(!body.to_string().contains("CANARY"), "{body}");
+        let keys: Vec<_> = body.as_object().unwrap().keys().map(String::as_str).collect();
+        assert_eq!(keys, if expected == StatusCode::CREATED { vec!["date", "id", "scheduled"] } else { vec!["reason"] });
+    }
+    let response = app.oneshot(Request::builder().uri("/organizer/questions")
+        .header("Authorization", format!("Bearer {ORGANIZER}")).body(Body::empty()).unwrap()).await.unwrap();
+    assert_eq!(response.headers()["cache-control"], "no-store");
+}
+
+#[test]
+fn browser_order_matches_the_pipeline_over_two_years_including_leap_day() {
+    use room::{answers::catalog::Catalog, club::ClubSlug, slot::{MeetupDate, slot_for_day}};
+    let cases: serde_json::Value = serde_json::from_str(include_str!("../../bank/fixtures/scheduling-order.json")).unwrap();
+    assert_eq!(cases.as_array().unwrap().len(), 731);
+    let q = q3_json();
+    let catalog = Catalog::from_records(vec![q.to_string()]);
+    for case in cases.as_array().unwrap() {
+        let day = case[0].as_str().unwrap();
+        assert_eq!(slot_for_day(&MeetupDate::parse(day).unwrap()), case[1].as_u64().unwrap() as usize, "{day}");
+        let arranged = catalog.prepare("q3", day, &ClubSlug::default_club()).unwrap();
+        for (i, index) in case[2].as_array().unwrap().iter().enumerate() {
+            assert_eq!(arranged.public().options()[i], q["options"][index.as_u64().unwrap() as usize]["text"], "{day}: {i}");
+        }
+    }
+}
+
+#[tokio::test]
+async fn affirmation_verification_and_both_used_record_formats_are_enforced() {
+    let mut cases = vec![];
+    for field in ["affirmed_by", "affirmed_at"] {
+        let mut q = q3_json(); q["review"].as_object_mut().unwrap().remove(field); cases.push(q);
+    }
+    let mut q = q3_json(); q["review"]["status"] = "pending".into(); cases.push(q);
+    let mut q = q3_json(); q["verified"] = serde_json::Value::Null; cases.push(q);
+    let mut q = q3_json(); q["used"] = json!({"meetup_date":"2026-10-01", "room_id":"old"}); cases.push(q);
+    let mut q = q3_json(); q["used"] = json!([{"club":"nyc", "meetup_date":"2026-10-01", "room_id":"old"}]); cases.push(q);
+    for q in cases {
+        let app = with_records(vec![q]);
+        assert_eq!(http(&app, Method::GET, "/organizer/questions", Some(ORGANIZER), None).await.1, json!({"questions":[]}));
+        assert_eq!(http(&app, Method::POST, "/organizer/schedule", Some(ORGANIZER),
+            Some(json!({"question_id":"q3", "date":"2026-10-21"}))).await.0, StatusCode::CONFLICT);
+    }
+    // Use in another club does not retire this club's question.
+    let mut q = q3_json(); q["used"] = json!([{"club":"la", "meetup_date":"2026-10-01", "room_id":"old"}]);
+    assert_eq!(http(&with_records(vec![q]), Method::POST, "/organizer/schedule", Some(NYC_ONLY),
+        Some(json!({"question_id":"q3", "date":"2026-10-21"}))).await.0, StatusCode::CREATED);
+}
+
+#[tokio::test]
+async fn releasing_a_browser_scheduled_question_removes_it_from_the_picker() {
+    let app = app();
+    http(&app, Method::POST, "/organizer/schedule", Some(ORGANIZER),
+        Some(json!({"question_id":"q3", "date":"2026-10-21"}))).await;
+    let hosted = host_room(&app).await;
+    for action in ["put-on-screen", "close-answers", "show-split", "walk-it", "reveal", "release"] {
+        assert_eq!(http(&app, Method::POST, &format!("/rooms/{}/{action}", hosted.id), Some(&hosted.host), None).await.0, StatusCode::OK);
+    }
+    let (_, body) = http(&app, Method::GET, "/organizer/questions", Some(ORGANIZER), None).await;
+    assert!(!body["questions"].as_array().unwrap().iter().any(|q| q["id"] == "q3"));
+    assert_eq!(http(&app, Method::POST, "/organizer/schedule", Some(ORGANIZER),
+        Some(json!({"question_id":"q3", "date":"2026-10-21"}))).await.0, StatusCode::CONFLICT);
+}
