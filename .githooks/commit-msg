#!/bin/sh
# commit-msg: the subject must be a Conventional Commit, `type(scope): description`.
#
# Opt-in and local: `just hooks` points core.hooksPath at this directory. Git
# does not version that setting, so a fresh clone runs no hooks until it is set.
#
# It checks the shape of the front of the subject and the blank line before a
# body, and nothing else. What follows the colon is free text: this project ends
# subjects with phase and ticket markers, `(RED)` or `(PQ-52 GREEN)`.
#
# Exempt, because git or a reviewer writes them: Merge ..., Revert "...", and
# fixup! / squash! / amend! subjects that an autosquash rebase folds away.
#
# Skip once with `git commit --no-verify`. Fixture tests:
#   bash .githooks/commit-msg.test.sh
# See .agents/skills/conventional-commits/SKILL.md.

msg_file=$1
[ -n "$msg_file" ] && [ -f "$msg_file" ] || exit 0

# Git's editor template adds `#` lines, and the message may start with blank lines.
message=$(grep -v '^#' "$msg_file" | sed '/./,$!d')
subject=$(printf '%s\n' "$message" | sed -n '1p')
second=$(printf '%s\n' "$message" | sed -n '2p')

# An empty message is git's to refuse, not ours.
[ -n "$subject" ] || exit 0

case $subject in
  "Merge "* | 'Revert "'* | "fixup! "* | "squash! "* | "amend! "*) exit 0 ;;
esac

types='feat|fix|docs|test|chore|refactor|ci|build|perf|style|revert'
pattern="^($types)(\\([A-Za-z0-9._/-]+\\))?!?: [^[:space:]]"

if ! printf '%s\n' "$subject" | grep -Eq "$pattern"; then
  cat >&2 <<EOF
commit-msg: the subject is not a Conventional Commit.

  $subject

Expected  type(scope): description
  type    one of: feat fix docs test chore refactor ci build perf style revert
  scope   optional, no spaces: fix(organizer-tui): ...
  !       before the colon marks a breaking change: feat(room)!: ...
  Then a colon, one space, and the description. Phase and ticket markers go at
  the end of the description: test(fallback): ... (PQ-52 RED)

Skip once with: git commit --no-verify
Guide: .agents/skills/conventional-commits/SKILL.md
EOF
  exit 1
fi

if [ -n "$second" ]; then
  cat >&2 <<EOF
commit-msg: leave a blank line between the subject and the body.

  $subject
  $second
EOF
  exit 1
fi

exit 0
