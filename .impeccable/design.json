  "narrative": {
    "northStar": "A well-made terminal",
    "overview": "Nostalgic and technical: muted greys, warm amber, monospace controls and data,\nand serif headings. The shared system stays quiet so the Rust program and the\nroom’s understanding carry the experience.",
    "keyCharacteristics": [
      "Projector-first, phone as buzzer.",
      "Light surfaces, white source wells, restrained depth.",
      "Counts rather than personal verdicts.",
      "Host-paced trace, with colour reserved for reading phases."
    ],
    "rules": [
      {
        "name": "The Accessible Companion Rule",
        "body": "Surface styles opt into focus-ring and success-text without replacing house tokens. text-muted is not AA-safe for small text, including metadata; retain the surface text-secondary overrides.",
        "section": "colors"
      },
      {
        "name": "The Wall Measurement Rule",
        "body": "Personal code defaults are not wall sizes. typemodel.js derives and refits wall source; other wall roles are scaled design-canvas values. Serif includes established large room identities and voting letters. See DESIGN.md for the scoped inventory and accepted amendments.",
        "section": "typography"
      }
    ],
    "dos": [
      "**Do** preserve the binding prototype decisions and their acceptance criteria.",
      "**Do** measure projector source fit using the venue’s dimensions and back-row distance.",
      "**Do** pair colour with text, a glyph, a count, or a structural signal.",
      "**Do** vendor the brand fonts and respect reduced-motion preferences."
    ],
    "donts": [
      "**Don’t** add gradients, glass, bounce, or extra panel radii.",
      "**Don’t** mark a participant wrong, introduce scores, or preview the answer to the host.",
      "**Don’t** promote prototype-only chrome or the dim-room proposal into the light product contract.",
      "**Don’t** balance correct-answer positions or treat a built deck as a run segment."
    ]
  }
}
