# Environment variables required by Rust NYC Pop Quiz.
# Source of truth: PRD.md, "Required Configuration".
#
# Names only — no value is ever assigned in this repository. Val Town scopes
# environment variables per val, and Modal stores Secrets server-side and
# references them by name; set real values there, never in a committed file.

# Discord OAuth2 — organizer authorization (Val Town)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
DISCORD_GUILD_ID=
DISCORD_ORGANIZER_ROLE_ID=

# Token and session cryptography (Val Town)
OAUTH_TOKEN_ENCRYPTION_KEY=
PARTICIPANT_SESSION_SIGNING_KEY=

# Val Town to Modal generation channel
MODAL_GENERATION_URL=
MODAL_PROXY_KEY=
MODAL_PROXY_SECRET=
GENERATION_HMAC_SECRET=

# Modal only — withheld from the Val Town application and from Rust Sandboxes
VAL_TOWN_GENERATION_CALLBACK_URL=
PYDANTIC_AI_GATEWAY_API_KEY=
PYDANTIC_AI_GENERATOR_MODEL=
PYDANTIC_AI_JUDGE_MODEL=
PYDANTIC_AI_EMBEDDING_MODEL=
MODAL_RUST_IMAGE_NAME=

# Uniqueness and fingerprinting (Val Town)
FINGERPRINT_ALGORITHM_VERSION=
# default: 20
SEMANTIC_TOP_K=
# default: 0.82
SEMANTIC_SIMILARITY_THRESHOLD=
# T-09: the M1 host stand-in credential (SPEC §8.2). Set as a Fly secret; never a value here.
HOST_DEV_TOKEN=
POPQUIZ_PUBLIC_URL=
# T-10: hosting by Discord role (SPEC 8). Names only; the values are Fly secrets.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_ROLE_ID=
